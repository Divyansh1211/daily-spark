# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=

# Shared secret for /api/cron (any long random string)
CRON_SECRET=

# Upstash Redis (free tier). Without these, data is kept in memory (local dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Single-server deployments (e.g. a VM): persist data to a JSON file instead of Upstash,
# and send due reminders from inside the app instead of an external cron.
DATA_FILE=
ENABLE_SCHEDULER=

# Code that unlocks the shared photos on a device
ACCESS_CODE=
# SQLite database for expenses (defaults to haanji.db next to DATA_FILE)
DB_FILE=
